my_shelf = dict()

#допиши ввод данных и добавление их в словарь

author = input("Введите автора (q - завершить)")
books_list = list()


while author != 'q':
    book = input('Введите книгу (s - стоп)')
    while book != 's':
        books_list.append(book)
        book = input('Введите книгу (s - стоп)')

    my_shelf[author] = books_list
    books_list = []
    author = input("Введите автора (q - завершить)")

for author, book in my_shelf.items():
    print(author, '-', book)